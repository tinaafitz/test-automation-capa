# =============================================================================
# CAPA Test Automation — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# =============================================================================

# --- Credentials (required) --------------------------------------------------
ROSA_TOKEN=               # OCM offline token from console.redhat.com/openshift/token
AWS_ACCESS_KEY_ID=         # AWS IAM access key
AWS_SECRET_ACCESS_KEY=     # AWS IAM secret key
AWS_REGION=us-west-2       # AWS region for cluster provisioning

# --- Application settings ----------------------------------------------------
APP_ENV=production         # development | production
LOG_LEVEL=info             # debug | info | warning | error
HOST=0.0.0.0
APP_PORT=3000              # Frontend (nginx) port
API_PORT=8000              # Backend (FastAPI) port
CORS_ORIGINS=http://localhost:3000

# --- Paths (container defaults shown) ----------------------------------------
KUBECONFIG=~/.kube/config          # Path to kubeconfig (mounted read-only)
USER_VARS_PATH=./vars/user_vars.yml  # Ansible user variables file
ANSIBLE_PATH=/app                  # Root path for Ansible playbooks

# --- Orchestrator mode -------------------------------------------------------
ORCHESTRATOR_MODE=local    # local | celery | aws
                           # local  = in-process subprocess execution (default)
                           # celery = distributed via Celery + Redis
                           # aws    = AWS Step Functions

# --- Redis (required for celery mode) ----------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Celery worker (only used with docker-compose --profile celery) -----------
CELERY_CONCURRENCY=4       # Number of concurrent Celery worker processes
CELERY_BROKER_URL=         # Override broker URL (defaults to REDIS_URL)
CELERY_RESULT_BACKEND=     # Override result backend (defaults to REDIS_URL)

# --- OpenShift Hub Cluster (optional, for MCE environment) --------------------
OCP_HUB_CLUSTER_API=       # https://api.cluster.example.com:6443
OCP_HUB_CLUSTER_PASSWORD=  # kubeadmin password

# --- OCM Service Account (alternative to ROSA_TOKEN) -------------------------
OCM_CLIENT_ID=
OCM_CLIENT_SECRET=
